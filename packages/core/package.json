{
  "name": "@cstf/core",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-agnostic shared core for ChinaTextbookStudyFree (web + iOS/macOS/RN). Pure TypeScript, no DOM/Next/RN dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./content": "./src/content.ts",
    "./srs": "./src/srs.ts",
    "./grade": "./src/grade.ts",
    "./subjects": "./src/subjects.ts",
    "./cosmetics": "./src/cosmetics.ts",
    "./cn": "./src/cn.ts",
    "./chestLogic": "./src/chestLogic.ts",
    "./economy": "./src/economy.ts",
    "./mascotTriggers": "./src/mascotTriggers.ts",
    "./achievements": "./src/achievements.ts",
    "./quests": "./src/quests.ts",
    "./rng": "./src/rng.ts",
    "./week": "./src/week.ts",
    "./league": "./src/league.ts",
    "./reading": "./src/reading.ts",
    "./backup": "./src/backup.ts",
    "./jump": "./src/jump.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
